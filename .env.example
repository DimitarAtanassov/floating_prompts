# Floating Prompts configuration.
# Copy to `.env` and adjust. All variables use the FP_ prefix and a `__`
# delimiter for nested settings (e.g. FP_DB__HOST -> settings.db.host).

# --- Application ---------------------------------------------------------
FP_ENVIRONMENT=local            # local | test | staging | production
FP_DEBUG=false

# --- Database ------------------------------------------------------------
FP_DB__HOST=localhost
FP_DB__PORT=5432
FP_DB__USER=postgres
FP_DB__PASSWORD=postgres
FP_DB__NAME=floating_prompts
FP_DB__ECHO=false

# --- HTTP server ---------------------------------------------------------
FP_SERVER__HOST=0.0.0.0
FP_SERVER__PORT=8000
# Allow the web UI (apps/web) dev server to call the API in the browser:
FP_SERVER__CORS_ORIGINS=["http://localhost:5173"]

# --- Auth ----------------------------------------------------------------
FP_AUTH__API_KEY_HEADER=X-API-Key

# --- Logging -------------------------------------------------------------
FP_LOG__LEVEL=INFO
FP_LOG__JSON_LOGS=true
